{
    "tabWidth": 4,
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "overrides": [
        {
            "files": ["*.json", "*.jsonc", "*.md", "*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
